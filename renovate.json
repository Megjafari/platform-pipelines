{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":semanticCommits"
  ],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Keep GitHub Actions updates in one PR",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    }
  ]
}
